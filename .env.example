# ── Control Plane ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Redis connection URL
REDIS_URL=redis://localhost:6379

# TTL (seconds) for caching identical prompt analyses
PROMPT_CACHE_TTL=60

# Maximum requests per minute per IP on /api routes
RATE_LIMIT_MAX=100

# ── Agent Service ──────────────────────────────────────────────────────────
AGENT_SERVICE_URL=http://localhost:8000

# ── Slack Notifications ───────────────────────────────────────────────────
# Bot OAuth token from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_CHANNEL=#security-alerts

# URL for 1-click remediation links in Slack messages
DASHBOARD_URL=https://security.internal/dashboard

# ── Kubernetes Sandbox ────────────────────────────────────────────────────
SANDBOX_NAMESPACE=llm-redteam-sandbox
SANDBOX_IMAGE=alpine:3.19
# TTL for sandbox jobs after completion (seconds)
SANDBOX_JOB_TTL=120

# ── Go Interceptor ────────────────────────────────────────────────────────
CONTROL_PLANE_URL=http://localhost:3000
CONTROL_PLANE_TIMEOUT_SECONDS=10
# Maximum request body size in bytes (default 64KB)
MAX_BODY_BYTES=65536

# ── Observability ─────────────────────────────────────────────────────────
# Grafana admin password (docker-compose only)
GRAFANA_PASSWORD=changeme
